{
  "name": "@cdr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "db:migrate": "dotenv -e ../../.env -- tsx src/database/migrate.cli.ts",
    "clean": "rm -rf dist .turbo coverage",
    "db:new": "tsx src/database/new-migration.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/client-sqs": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@cdr/config": "workspace:*",
    "@cdr/contracts": "workspace:*",
    "@cdr/messaging": "workspace:*",
    "@cdr/shared": "workspace:*",
    "@cdr/storage": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.2.0",
    "drizzle-orm": "^0.44.6",
    "openai": "^4.104.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@cdr/eslint-config": "workspace:*",
    "@cdr/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.38.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
