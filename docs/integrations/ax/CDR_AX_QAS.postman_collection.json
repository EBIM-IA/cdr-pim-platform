        {
          "name": "6. Cuerpo mayor a 100 KiB",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = `AX-QAS-LARGE-${pm.variables.replaceIn('{{$guid}}')}`;",
                  "const payload = { idLote: id, fechaEnvio: new Date().toISOString(), sistemaOrigen: 'X'.repeat(103000), productos: [{ codigoArticulo: '000123', codigoProveedor: 'PRV-001', codigoLinea: 'RODAMIENTOS' }] };",
                  "pm.variables.set('oversizedPayload', JSON.stringify(payload));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 413', () => pm.response.to.have.status(413));",
                  "pm.test('PAYLOAD_TOO_LARGE', () => pm.expect(pm.response.json().error.code).to.eql('PAYLOAD_TOO_LARGE'));",
                  "pm.variables.unset('oversizedPayload');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{oversizedPayload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/sincronizar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos", "sincronizar"]
            },
            "description": "Supera deliberadamente el límite del parser. Esperado 413.",
