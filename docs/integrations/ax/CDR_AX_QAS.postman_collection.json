          "raw": "{\n  \"idLote\": \"AX-QAS-{{$timestamp}}-TWO\",\n  \"fechaEnvio\": \"{{fechaEnvio}}\",\n  \"sistemaOrigen\": \"SISMETIC_AX\",\n  \"productos\": [\n    {\n      \"codigoArticulo\": \"000123\",\n      \"codigoProveedor\": \"PRV-001\",\n      \"codigoUnificador\": \"UNI-6205\",\n      \"codigoLinea\": \"RODAMIENTOS\",\n      \"tipoAplicacion\": \"AUTOMOTRIZ\",\n      \"marca\": \"SKF\",\n      \"fechaModificacion\": \"2026-09-28T15:00:00Z\"\n    },\n    {\n      \"codigoArticulo\": \"000456\",\n      \"codigoProveedor\": \"PRV-002\",\n      \"codigoLinea\": \"SELLOS\",\n      \"tipoAplicacion\": \"INDUSTRIAL\",\n      \"marca\": \"NTN\",\n      \"fechaModificacion\": \"2026-09-28T10:00:00-05:00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos/sincronizar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "productos", "sincronizar"]
        },
        "description": "Lote de 2 productos completos.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Leading-zero codigoArticulo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('correlation id returned', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string'));",
              "pm.test('estado RECIBIDO', () => pm.expect(pm.response.json().estado).to.eql('RECIBIDO'));",
