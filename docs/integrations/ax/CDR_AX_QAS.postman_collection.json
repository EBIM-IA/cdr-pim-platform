    {
      "name": "Idempotencia y límites del contrato",
      "description": "Ejecute en orden. La primera solicitud congela idLote y fechaEnvio; el reintento usa exactamente el mismo contenido. La prueba 429 es deliberadamente manual para no afectar a otros usuarios de QAS.",
      "item": [
        {
          "name": "1. Primera entrega idempotente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyBatchId', `AX-QAS-IDEMP-${pm.variables.replaceIn('{{$guid}}')}`);",
                  "pm.collectionVariables.set('idempotencySentAt', new Date().toISOString());",
                  "pm.collectionVariables.unset('idempotencyReceivedAt');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('estado RECIBIDO', () => pm.expect(body.estado).to.eql('RECIBIDO'));",
                  "pm.collectionVariables.set('idempotencyReceivedAt', body.fechaRecepcion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idLote\": \"{{idempotencyBatchId}}\",\n  \"fechaEnvio\": \"{{idempotencySentAt}}\",\n  \"sistemaOrigen\": \"SISMETIC_AX\",\n  \"productos\": [\n    {\n      \"codigoArticulo\": \"000123\",\n      \"codigoProveedor\": \"PRV-001\",\n      \"codigoUnificador\": \"UNI-6205\",\n      \"codigoLinea\": \"RODAMIENTOS\",\n      \"tipoAplicacion\": \"AUTOMOTRIZ\",\n      \"marca\": \"SKF\",\n      \"fechaModificacion\": \"{{idempotencySentAt}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos/sincronizar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "productos", "sincronizar"]
            },
            "description": "Crea un lote y congela su identidad y contenido para las dos pruebas siguientes.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2. Reintento exacto sin duplicación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('devuelve el recibo original', () => pm.expect(body.fechaRecepcion).to.eql(pm.collectionVariables.get('idempotencyReceivedAt')));"
                ]
