{
  "info": {
    "name": "CDR PIM — AX Integration (QAS Inbound)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Guía operativa v1.2 para el contrato Sismetic / Dynamics AX → CDR PIM API v1.1. AX envía y el PIM recibe. El lote queda guardado antes del 202; reintentos idénticos son idempotentes y existe consulta de estado. La aplicación al catálogo maestro se mantiene separada hasta aprobar el mapeo.\n\nConfigure la variable accessToken con el token entregado por canal seguro. NUNCA guarde el token real en la colección exportada ni lo comparta por correo o chat."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.collectionVariables.set('fechaEnvio', new Date().toISOString());"]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://pim-qas.casadelruliman.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "fechaEnvio",
      "value": ""
    },
    {
      "key": "lastBatchId",
      "value": ""
    },
    {
      "key": "idempotencyBatchId",
      "value": ""
    },
    {
      "key": "idempotencySentAt",
      "value": ""
    },
    {
      "key": "idempotencyReceivedAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Valid batch (2 productos, X-Correlation-Id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('correlation id returned', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string'));",
              "pm.test('estado RECIBIDO', () => pm.expect(pm.response.json().estado).to.eql('RECIBIDO'));",
              "pm.test('AX inbound header', () => pm.expect(pm.response.headers.get('X-CDR-AX-Inbound')).to.eql('true'));",
              "pm.collectionVariables.set('lastBatchId', pm.response.json().idLote);",
              "pm.test('correlationId propagado', () => pm.expect(pm.response.json().correlationId).to.eql('sismetic-postman-0001'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-Id",
            "value": "sismetic-postman-0001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idLote\": \"AX-QAS-{{$guid}}-VALID\",\n  \"fechaEnvio\": \"{{fechaEnvio}}\",\n  \"sistemaOrigen\": \"SISMETIC_AX\",\n  \"productos\": [\n    {\n      \"codigoArticulo\": \"000123\",\n      \"codigoProveedor\": \"PRV-001\",\n      \"codigoUnificador\": \"UNI-6205\",\n      \"codigoLinea\": \"RODAMIENTOS\",\n      \"tipoAplicacion\": \"AUTOMOTRIZ\",\n      \"marca\": \"SKF\",\n      \"fechaModificacion\": \"{{fechaEnvio}}\"\n    },\n    {\n      \"codigoArticulo\": \"000456\",\n      \"codigoProveedor\": \"PRV-002\",\n      \"codigoLinea\": \"SELLOS\",\n      \"tipoAplicacion\": \"INDUSTRIAL\",\n      \"marca\": \"NTN\",\n      \"fechaModificacion\": \"{{fechaEnvio}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos/sincronizar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "productos", "sincronizar"]
