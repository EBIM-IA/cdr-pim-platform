    {
      "name": "codigoArticulo as number (schema error)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('correlation id returned', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string'));",
              "pm.test('VALIDATION_FAILED', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));"
