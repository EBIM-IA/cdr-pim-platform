          "raw": "{{baseUrl}}/api/v1/productos/sincronizar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "productos", "sincronizar"]
        },
        "description": "codigoArticulo con ceros a la izquierda: se valida como string y se conserva literal (no se convierte a número).",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "No token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('correlation id returned', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string'));",
              "pm.test('UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idLote\": \"AX-QAS-{{$timestamp}}-NOTOKEN\",\n  \"fechaEnvio\": \"{{fechaEnvio}}\",\n  \"sistemaOrigen\": \"SISMETIC_AX\",\n  \"productos\": [\n    {\n      \"codigoArticulo\": \"000123\",\n      \"codigoProveedor\": \"PRV-001\",\n      \"codigoUnificador\": \"UNI-6205\",\n      \"codigoLinea\": \"RODAMIENTOS\",\n      \"tipoAplicacion\": \"AUTOMOTRIZ\",\n      \"marca\": \"SKF\",\n      \"fechaModificacion\": \"2026-09-28T15:00:00Z\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos/sincronizar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "productos", "sincronizar"]
        },
        "description": "Sin header Authorization. Esperado 401 UNAUTHORIZED.",
        "auth": {
          "type": "noauth"
        }
      }
    },
