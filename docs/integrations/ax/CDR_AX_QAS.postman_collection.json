    },
    {
      "name": "Consultar último lote recibido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('estado RECIBIDO', () => pm.expect(pm.response.json().estado).to.eql('RECIBIDO'));",
              "pm.test('requestHash presente', () => pm.expect(pm.response.json().requestHash).to.match(/^sha256:[0-9a-f]{64}$/));",
              "pm.test('AX inbound header', () => pm.expect(pm.response.headers.get('X-CDR-AX-Inbound')).to.eql('true'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos/sincronizaciones/{{lastBatchId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "productos", "sincronizaciones", "{{lastBatchId}}"]
        },
        "description": "Consulta el estado persistente del último lote válido ejecutado en esta colección.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    }
