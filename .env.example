# =============================================================================
# Casa del Rulimán — PIM · Local development configuration
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored.
#
#   cp .env.example .env
#
# NEVER put a real credential in this file. In QAS and PRD every secret is injected by
# ECS from AWS Secrets Manager and none of them is ever written to disk or to git.
# The values below are local-only placeholders and are safe by construction: the
# PostgreSQL password only works against a container on 127.0.0.1, and the JWT secrets
# are obvious dummies that the configuration schema rejects in qas/prd... check
# SECURITY_BASELINE.md before changing that assumption.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
APP_VERSION=0.0.0-local

# ---- API --------------------------------------------------------------------
# SERVICE_NAME is intentionally NOT set here: the API and the worker read the same root
# .env, and a shared value would label every worker log line as "cdr-pim-api". Each app's
# configuration schema supplies its own correct default.
PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ---- Database ---------------------------------------------------------------
# Matches docker-compose.yml. `cdr_pim_test` is created by the same container for
# `pnpm test:integration`.
DATABASE_URL=postgres://cdr:cdr_local_dev@localhost:5432/cdr_pim
TEST_DATABASE_URL=postgres://cdr:cdr_local_dev@localhost:5432/cdr_pim_test
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# With DATABASE_SSL=true the server is always verified (verify-full: chain + hostname). This
# bundle replaces the default trust store for that connection. The API image sets it to the
# shipped AWS RDS bundle (/app/certs/rds-global-bundle.pem); QAS/PRD refuse to start without it.
# DATABASE_SSL_CA_FILE=apps/api/certs/rds-global-bundle.pem
# Exactly 1 in QAS/PRD (the ALB, or the web BFF that forwards the ALB's client address);
# never trust arbitrary forwarded addresses. Direct local connections keep this at zero.
TRUST_PROXY_HOPS=0

# ---- Authentication ---------------------------------------------------------
# Temporary local identity source. Every credential comes from the environment; there is
# no account or password embedded in source. `AUTH_MODE=local` is always rejected in prd.
# In qas it is accepted only with ALLOW_LOCAL_AUTH_IN_QAS=true — a temporary, explicit
# opt-in until CDR chooses AD/OIDC or another durable identity provider. Change the local
# password in your untracked `.env`.
AUTH_MODE=local
# ALLOW_LOCAL_AUTH_IN_QAS=false
AUTH_LOCAL_USER_ID=local-admin
AUTH_LOCAL_EMAIL=admin@casadelruliman.local
AUTH_LOCAL_PASSWORD=change-this-local-password
AUTH_LOCAL_ROLES=ADMIN

# Local signing dummy. Minimum 32 characters, enforced by the configuration schema.
# Generate a real signing secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=local-development-only-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_ISSUER=cdr-pim-api
JWT_AUDIENCE=cdr-pim-web
JWT_ALGORITHM=HS256

# Application-layer defense in depth. Edge throttling/WAF remains required in AWS.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_LOGIN_BLOCK_MS=300000
RATE_LIMIT_AI=10
RATE_LIMIT_INDEX=5

# ---- Artificial intelligence ------------------------------------------------
# `fake` keeps development and CI free of network calls and of cost. Switch to `openai`
# only with a real key, and never commit that key.
AI_PROVIDER=fake
AI_GENERATION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# MUST equal the vector(N) width in migration 0002. Changing it needs a new migration
# plus a full re-embedding.
AI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_MS=30000
# OPENAI_API_KEY=

# ---- Asynchronous processing ------------------------------------------------
# `memory` needs nothing running. To exercise the real SQS adapter locally:
#   docker compose --profile aws up -d
#   QUEUE_DRIVER=sqs
QUEUE_DRIVER=memory
AWS_REGION=us-east-1
# LocalStack endpoint. MUST be empty in QAS/PRD so the SDK resolves real AWS endpoints.
# AWS_ENDPOINT_URL=http://localhost:4566
# SQS_JOBS_QUEUE_URL=http://localhost:4566/000000000000/cdr-pim-local-jobs

# Dummy credentials for LocalStack. In AWS the ECS task role supplies real ones and these
# variables are absent.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ---- Worker -----------------------------------------------------------------
# The worker reads this same file. `pnpm dev` starts it on its own port; only override
# PORT here if you run the worker alone.
# PORT=3002
QUEUE_WAIT_TIME_SECONDS=20
QUEUE_MAX_MESSAGES=10
QUEUE_VISIBILITY_TIMEOUT_SECONDS=120
QUEUE_MAX_HANDLER_ATTEMPTS=3
QUEUE_RETRY_BASE_DELAY_MS=200
SHUTDOWN_TIMEOUT_MS=25000

# ---- Object storage ---------------------------------------------------------
STORAGE_DRIVER=memory
# S3_BUCKET_ASSETS=cdr-pim-local-assets
S3_PRESIGN_TTL_SECONDS=900

# ---- Web (Next.js) ----------------------------------------------------------
# Read at runtime by Next.js server components; may be an internal address in AWS.
API_BASE_URL=http://localhost:3001
# The origin users reach the web app at (no path). Login/logout accept only requests whose
# Origin header matches it, and redirects are built from it. Must be https in QAS/PRD.
PUBLIC_APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time. Never put an
# environment-specific URL here: it would make the image unpromotable.
NEXT_PUBLIC_APP_NAME="Casa del Rulimán · PIM"
